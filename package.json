{
    "name": "@wpazderski/playwright-utils",
    "version": "1.0.2",
    "description": "Common Playwright utils",
    "keywords": [
        "playwright",
        "utils"
    ],
    "author": "Witold Pazderski",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/wpazderski/playwright-utils.git"
    },
    "homepage": "https://github.com/wpazderski/playwright-utils",
    "bugs": {
        "url": "https://github.com/wpazderski/playwright-utils/issues"
    },
    "type": "module",
    "exports": {
        "./*": "./dist/*",
        "./webEnvExtensions/assertions/matchers/common": null,
        "./webEnvExtensions/assertions/matchers/common.js": null
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "prepare": "husky",
        "build": "rimraf ./dist/ && rimraf -g ./node_modules/.tmp/*.tsbuildinfo && tsc -b && rm -f ./dist/webEnvExtensions/assertions/matchers/common.d.ts",
        "build-docs": "node ./scripts/build-docs.ts",
        "lint-check": "eslint ./ --flag unstable_native_nodejs_ts_config --flag unstable_config_lookup_from_file --max-warnings 0",
        "lint-fix": "eslint ./ --flag unstable_native_nodejs_ts_config --flag unstable_config_lookup_from_file --max-warnings 0 --fix",
        "prettier-check": "prettier ./ --check",
        "prettier-fix": "prettier ./ --write",
        "tsc-check": "tsc -b --noEmit",
        "check-licenses": "check-licenses",
        "check-outdated-packages": "check-outdated-packages",
        "check-all": "run-s lint-check prettier-check tsc-check check-licenses check-outdated-packages",
        "pre-commit-checks": "run-s check-all",
        "dev": "vite --config devServer/vite.config.ts --port 7102",
        "start-test-server": "cross-env IS_TEST_ENV=true vite --config devServer/vite.config.ts --host --port 7102",
        "test-chromium": "playwright test --project=chromium",
        "test-firefox": "playwright test --project=firefox",
        "test-webkit": "playwright test --project=webkit",
        "test": "playwright test --project=chromium",
        "test-all": "playwright test"
    },
    "dependencies": {
        "@jest/expect-utils": "^30.0.5",
        "jest-get-type": "^29.6.3",
        "jest-matcher-utils": "^30.0.5"
    },
    "devDependencies": {
        "@playwright/test": "^1.54.2",
        "@types/node": "^24.2.1",
        "@types/web": "^0.0.261",
        "@wpazderski/eslint-config": "^1.0.5",
        "@wpazderski/node-package-tools": "^1.0.0",
        "@wpazderski/playwright-config": "^1.0.4",
        "@wpazderski/prettier-config": "^1.0.3",
        "@wpazderski/typescript-config": "^1.0.4",
        "cross-env": "^10.0.0",
        "eslint": "^9.33.0",
        "husky": "^9.1.7",
        "npm-run-all": "^4.1.5",
        "prettier": "^3.6.2",
        "rimraf": "^6.0.1",
        "typedoc": "^0.28.10",
        "typedoc-github-theme": "^0.3.0",
        "typescript": "^5.9.2",
        "vite": "^7.1.2"
    },
    "peerDependencies": {
        "@playwright/test": "^1.52.0"
    },
    "packageManager": "pnpm@10.11.0",
    "engines": {
        "node": ">=24.0.0",
        "pnpm": ">=10.0.0",
        "npm": "please-use-pnpm",
        "yarn": "please-use-pnpm"
    }
}
